.env
.venv/
server/*.sqlite3
server/**/*.sqlite3
__pycache__/
*.py[cod]
client/node_modules/
client/dist/

# Per-corpus files are redundant with all.jsonl, which the server actually
# loads (server/app.py CHUNKS_PATH). all.jsonl is tracked so a deployment
# built from a clone has evidence to search - without it the service starts
# with an empty index.
data/corpus/*.jsonl
!data/corpus/all.jsonl
data/complaints/**/complaints.jsonl

# Regenerate with server.rag.embed_corpus. Real Gemini API cost to rebuild.
server/rag/embeddings.jsonl
server/rag/chunks.jsonl

# Stray Python installer artifacts
python-3.12.*.exe
python-*install*.log
python-msi-uninstall.log
python-3.12.5-amd64.exe
python-install.log

.claude/settings.local.json
